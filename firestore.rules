rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Regra para perfil de usuários
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Regra para orçamentos (usuário só acessa e altera seus próprios orçamentos)
    match /orcamentos/{orcamentoId} {
      allow read: if request.auth != null && (resource == null || resource.data.userId == request.auth.uid);
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }
    
    // Regra para histórico de clientes
    match /clientes/{clienteId} {
      allow read: if request.auth != null && (resource == null || resource.data.userId == request.auth.uid);
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }
    
    // Regra para materiais padrão da empresa
    match /materiais_padrao/{matId} {
      allow read: if request.auth != null && (resource == null || resource.data.userId == request.auth.uid);
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }
    
    // Regra para configurações da empresa
    match /configuracoes/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
